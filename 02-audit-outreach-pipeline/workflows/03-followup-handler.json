      "id": "filter-followup2-ready",
      "name": "Filter - 7 Days Passed No Reply",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('set-config').item.json.anthropic_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 512,\n  \"system\": \"Write a final breakup email for Ayo. Under 60 words. Warm, genuine, slightly self-aware. Leaves door completely open. No hard sell. No dashes in subject line. Sign as Ayo. Return ONLY valid JSON: {\\\"subject\\\": \\\"...\\\", \\\"body\\\": \\\"...\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Breakup email for {{ $json.business_name }}, a {{ $json.niche }} in {{ $json.town }}, {{ $json.state }}. No reply after 2 emails over 7 days. Score was {{ $json.total_score }}/100. Return ONLY the JSON.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "claude-breakup",
      "name": "Claude - Write Breakup Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        500
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ (() => { try { return JSON.parse($json.content[0].text).subject; } catch(e) { return 'Last one from me'; } })() }}",
        "emailType": "text",
        "message": "={{ (() => { try { return JSON.parse($json.content[0].text).body; } catch(e) { return $json.content[0].text; } })() }}",
        "options": {
          "senderName": "Ayo",
          "replyTo": "={{ $('set-config').item.json.sender_email }}"
        }
      },
      "id": "gmail-breakup",
      "name": "Gmail - Send Breakup Email",
      "type": "n8n-nodes-base.gmail",
