    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "7-days-passed",
              "leftValue": "={{ Math.floor((new Date() - new Date($json.date_emailed)) / (1000 * 60 * 60 * 24)) }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "not-replied",
              "leftValue": "={{ $json.replied }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
