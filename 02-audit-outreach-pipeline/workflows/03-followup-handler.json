    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "mode": "id",
          "value": "=YOUR_GOOGLE_SHEET_ID_HERE"
        },
        "sheetName": {
          "mode": "name",
          "value": "Qualified Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "replied": "true",
            "reply_sentiment": "={{ $json.sentiment }}",
            "status": "={{ $json.sentiment === 'NEGATIVE' ? 'opted_out' : $json.sentiment === 'READY' ? 'ready_for_audit' : $json.sentiment === 'POSITIVE' ? 'interested' : 'replied_followup_needed' }}"
          }
        },
        "where": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $json.their_email }}"
            }
          ]
        },
        "options": {}
      },
