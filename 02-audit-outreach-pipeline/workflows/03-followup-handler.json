      "typeVersion": 2,
      "position": [
        0,
        800
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      },
      "id": "wait-1-min",
      "name": "Wait 1 Minute (Human Feel)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        800
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "mode": "id",
          "value": "=YOUR_GOOGLE_SHEET_ID_HERE"
        },
        "sheetName": {
          "mode": "name",
          "value": "Qualified Leads"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $json.body.from }}"
            }
          ]
        },
        "options": {}
      },
      "id": "find-lead",
      "name": "Find Lead By Email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        440,
        800
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "=YOUR_ANTHROPIC_API_KEY_HERE"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are Ayo's reply assistant. Analyse incoming email replies from business owners.\\n\\nSentiment:\\n- POSITIVE: Interested, asking questions, want to know more\\n- NEUTRAL: Non-committal, maybe, busy right now\\n- NEGATIVE: Not interested, unsubscribe, stop emailing\\n- READY: Want the audit now, ready to talk\\n\\nResponses:\\n- POSITIVE: Thank them, tell them you'll send audit shortly, build excitement\\n- NEUTRAL: Acknowledge their time, give ONE compelling reason to look at audit\\n- NEGATIVE: Apologise politely, wish them well\\n- READY: Express excitement, confirm sending audit, ask good time to chat\\n\\nUnder 100 words. Warm and human. Sign as Ayo.\\n\\nReturn ONLY valid JSON: {\\\"sentiment\\\": \\\"POSITIVE|NEUTRAL|NEGATIVE|READY\\\", \\\"reply\\\": \\\"...\\\", \\\"action\\\": \\\"send_audit|continue_sequence|stop_sequence|schedule_call\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Business: {{ $json.business_name }}\\nNiche: {{ $json.niche }}\\nTheir reply: {{ $('reply-webhook').item.json.body.message }}\\nOriginal subject: {{ $json.email_subject }}\\n\\nReturn ONLY the JSON.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "claude-analyse-reply",
      "name": "Claude - Analyse Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        800
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sentiment",
              "name": "sentiment",
              "value": "={{ (() => { try { return JSON.parse($json.content[0].text).sentiment; } catch(e) { return 'NEUTRAL'; } })() }}",
              "type": "string"
            },
            {
              "id": "suggested_reply",
              "name": "suggested_reply",
              "value": "={{ (() => { try { return JSON.parse($json.content[0].text).reply; } catch(e) { return ''; } })() }}",
              "type": "string"
            },
            {
              "id": "action",
              "name": "action",
              "value": "={{ (() => { try { return JSON.parse($json.content[0].text).action; } catch(e) { return 'continue_sequence'; } })() }}",
              "type": "string"
            },
            {
              "id": "business_name",
              "name": "business_name",
              "value": "={{ $('find-lead').item.json.business_name }}",
              "type": "string"
            },
            {
              "id": "their_email",
              "name": "their_email",
              "value": "={{ $('reply-webhook').item.json.body.from }}",
              "type": "string"
            },
            {
              "id": "their_reply",
              "name": "their_reply",
              "value": "={{ $('reply-webhook').item.json.body.message }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "parse-reply",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [
        880,
        800
