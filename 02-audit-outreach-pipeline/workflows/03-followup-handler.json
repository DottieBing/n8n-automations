      "id": "get-followup1-leads",
      "name": "Get Email 1 Sent Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "3-days-passed",
              "leftValue": "={{ Math.floor((new Date() - new Date($json.date_emailed)) / (1000 * 60 * 60 * 24)) }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "not-replied",
              "leftValue": "={{ $json.replied }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-followup1-ready",
      "name": "Filter - 3 Days Passed No Reply",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('set-config').item.json.anthropic_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 512,\n  \"system\": \"Write a short follow-up email for Ayo. Under 80 words. Human not pushy. Add ONE new angle. Reference the audit briefly. Soft CTA. No dashes in subject line. Sign as Ayo. Return ONLY valid JSON: {\\\"subject\\\": \\\"...\\\", \\\"body\\\": \\\"...\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Follow-up #1 for {{ $json.business_name }}, a {{ $json.niche }} in {{ $json.town }}, {{ $json.state }}. Score: {{ $json.total_score }}/100. Original subject: {{ $json.email_subject }}. Sent 3 days ago, no reply. Return ONLY the JSON.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "claude-followup1",
      "name": "Claude - Write Follow-up 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ (() => { try { return JSON.parse($json.content[0].text).subject; } catch(e) { return 'Re: ' + $json.email_subject; } })() }}",
        "emailType": "text",
        "message": "={{ (() => { try { return JSON.parse($json.content[0].text).body; } catch(e) { return $json.content[0].text; } })() }}",
        "options": {
          "senderName": "Ayo",
          "replyTo": "={{ $('set-config').item.json.sender_email }}"
        }
      },
      "id": "gmail-followup1",
      "name": "Gmail - Send Follow-up 1",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "mode": "id",
          "value": "={{ $('set-config').item.json.google_sheet_id }}"
        },
        "sheetName": {
          "mode": "name",
          "value": "Qualified Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "followup_1_sent",
            "followup_1_sent": "true"
          }
        },
        "where": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $json.email }}"
            }
          ]
        },
        "options": {}
      },
      "id": "update-followup1",
      "name": "Update - Follow-up 1 Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1320,
