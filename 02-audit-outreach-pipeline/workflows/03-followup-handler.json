    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "mode": "id",
          "value": "=YOUR_GOOGLE_SHEET_ID_HERE"
        },
        "sheetName": {
          "mode": "name",
          "value": "Review Queue"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "business_name": "={{ $('parse-reply').item.json.business_name }}",
            "their_email": "={{ $('parse-reply').item.json.their_email }}",
            "their_reply": "={{ $('parse-reply').item.json.their_reply }}",
            "sentiment": "={{ $('parse-reply').item.json.sentiment }}",
            "suggested_reply": "={{ $('parse-reply').item.json.suggested_reply }}",
            "action": "={{ $('parse-reply').item.json.action }}",
            "reviewed": "false",
            "timestamp": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "queue-review",
      "name": "Queue For Your Review",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1320,
        800
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "={{ '🔔 ' + $('parse-reply').item.json.sentiment + ' reply from ' + $('parse-reply').item.json.business_name }}",
        "emailType": "text",
        "message": "=Hey Ayo! 👋\n\nYou got a {{ $('parse-reply').item.json.sentiment }} reply!\n\nBusiness: {{ $('parse-reply').item.json.business_name }}\nTheir message: {{ $('parse-reply').item.json.their_reply }}\n\nSuggested reply:\n{{ $('parse-reply').item.json.suggested_reply }}\n\nAction: {{ $('parse-reply').item.json.action }}\n\nCheck your Review Queue sheet to approve and send. 🔥",
        "options": {
          "senderName": "Ayo Workflow"
        }
      },
      "id": "gmail-notify",
      "name": "Gmail - Notify Ayo",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
