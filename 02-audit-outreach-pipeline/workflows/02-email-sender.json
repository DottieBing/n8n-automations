    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.anthropic_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 4000,\n  \"system\": \"You are a sharp local business marketing analyst. Analyse this business and produce a detailed audit in JSON format.\\n\\nScoring (100 points total):\\n- Google Reviews Score (25pts): 0-10 reviews=5, 11-50=12, 51-200=18, 200+=25\\n- Review Rating (15pts): below 3=3, 3-3.9=8, 4-4.4=11, 4.5+=15\\n- Owner Response Rate (15pts): 0=0, 1-30%=5, 31-60%=10, 61-100%=15\\n- Photos Count (10pts): 0-5=2, 6-20=5, 21-50=8, 50+=10\\n- Website Quality (20pts): no CTA=8, has CTA=20\\n- Business Description (5pts): none=0, short=2, detailed=5\\n- Call Answering (10pts): always 3 — we attempted to call and got no answer\\n\\nCategory:\\n- needs_website: poor website, no CTA\\n- needs_ai_receptionist: busy business, likely missing calls\\n- needs_both: poor website AND likely missing calls\\n\\nReturn ONLY valid JSON with no extra text:\\n{\\\"category\\\": \\\"needs_website|needs_ai_receptionist|needs_both\\\", \\\"total_score\\\": 0, \\\"grade\\\": \\\"A|B|C|D|F\\\", \\\"scores\\\": {\\\"reviews_score\\\": 0, \\\"rating_score\\\": 0, \\\"response_rate_score\\\": 0, \\\"photos_score\\\": 0, \\\"website_score\\\": 0, \\\"description_score\\\": 0, \\\"call_score\\\": 3}, \\\"findings\\\": {\\\"reviews\\\": \\\"specific finding\\\", \\\"rating\\\": \\\"specific finding\\\", \\\"response_rate\\\": \\\"specific finding\\\", \\\"photos\\\": \\\"specific finding\\\", \\\"website\\\": \\\"specific finding\\\", \\\"description\\\": \\\"specific finding\\\", \\\"call_test\\\": \\\"We attempted to call [business] at [phone] and received no answer. Potential customers calling after hours or during busy periods are likely going to a competitor.\\\"}, \\\"recommendations\\\": {\\\"primary\\\": \\\"most important fix\\\", \\\"secondary\\\": \\\"second most important\\\", \\\"quick_wins\\\": [\\\"win 1\\\", \\\"win 2\\\", \\\"win 3\\\"]}, \\\"pain_points\\\": [\\\"pain 1\\\", \\\"pain 2\\\", \\\"pain 3\\\"], \\\"pitch_angle\\\": \\\"best one sentence pitch for this business\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyse:\\n\\nBusiness: {{ $json.business_name }}\\nType: {{ $json.category }}\\nTown: {{ $json.town }}\\nState: {{ $json.state }}\\nCountry: {{ $json.country }}\\nPhone: {{ $json.phone }}\\nWebsite: {{ $json.website }}\\nHas CTA: {{ $json.has_cta }}\\nRating: {{ $json.rating }} stars\\nReviews: {{ $json.review_count }}\\nOwner Responses: {{ $json.owner_answers }}\\nPhotos: {{ $json.photos_count }}\\nDescription: {{ $json.description || 'NONE' }}\\n\\nReturn ONLY the JSON.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
