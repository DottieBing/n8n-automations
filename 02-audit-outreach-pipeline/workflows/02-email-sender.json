              "value": "={{ (() => { try { const text = $json.content[0].text; const clean = text.replace(/```json|```/g, '').trim(); return JSON.parse(clean); } catch(e) { return { category: 'needs_both', total_score: 30, grade: 'D', scores: {}, findings: { call_test: 'Call attempted, no answer.' }, recommendations: {}, pain_points: [], pitch_angle: '' }; } })() }}",
