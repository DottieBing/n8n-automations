    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.anthropic_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are Ayo, a sharp digital marketing consultant who helps local businesses get more customers. Write a cold email that feels like it was written personally for this one business.\\n\\nRules:\\n1. Subject line must create curiosity. NOT salesy. NEVER use dashes - or — in subject lines.\\n2. Open with something hyper-specific to THEIR business\\n3. Reference their real data — rating, reviews, location\\n4. Reference the failed call naturally — tried calling, no one picked up\\n5. ONE focused pain point\\n6. Offer free audit, no strings\\n7. ONE soft CTA — just reply yes\\n8. MAX 120 words\\n9. Human tone, not corporate\\n10. Sign off as Ayo\\n\\nFor needs_website: focus on what poor website is costing them\\nFor needs_ai_receptionist: focus on missed calls = missed revenue\\nFor needs_both: lead with missed call angle\\n\\nStyle WITH website: 'Hey [NAME], I was searching for [niche] in [town] and came across your business. You've got some really solid reviews. I noticed a few things on your google listing that could be costing you calls though. I put together a full breakdown if you'd like to see. No charge, No strings. Just thought it might help. — Ayo'\\n\\nStyle WITHOUT website: 'Hey [NAME], I was trying to find your website when searching for [niche] in [town] but couldn't find one. I know that's probably not at the top of your priority list when you're busy running your business, but it might be costing you more customers than you think. Happy to share what I found if you're open to it. — Ayo'\\n\\nThese are STYLE references only. Write something fresh and specific to THIS business.\\n\\nReturn ONLY valid JSON: {\\\"subject\\\": \\\"...\\\", \\\"body\\\": \\\"...\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write cold email for:\\n\\nBusiness: {{ $json.business_name }}\\nNiche: {{ $json.niche }}\\nTown: {{ $json.town }}\\nState: {{ $json.state }}\\nCountry: {{ $json.country }}\\nPhone: {{ $json.phone }}\\nWebsite: {{ $json.website }}\\nHas CTA: {{ $json.has_cta }}\\nRating: {{ $json.rating }} stars ({{ $json.review_count }} reviews)\\nPhotos: {{ $json.photos_count }}\\nCategory: {{ $json.analysis.category }}\\nPitch Angle: {{ $json.analysis.pitch_angle }}\\nPain Points: {{ $json.analysis.pain_points }}\\nCall Finding: {{ $json.analysis.findings.call_test }}\\n\\nReturn ONLY the JSON.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
