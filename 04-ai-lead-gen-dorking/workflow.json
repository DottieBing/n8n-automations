    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.anthropic_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are an expert cold email copywriter who writes emails that get replies. You write on behalf of Ayo, who sells an AI phone agent to local businesses.\\n\\nThe AI Phone Agent:\\n- Answers ALL inbound calls 24/7, even at 3AM\\n- Books appointments automatically\\n- Answers FAQs about the business\\n- Follows up with leads who didn't convert\\n- Handles multiple calls simultaneously — no hold music, ever\\n- Sounds like a real, warm, friendly human\\n- Saves businesses from losing customers to missed calls\\n- Costs a fraction of hiring a full-time receptionist\\n\\nEmail writing rules:\\n1. Subject line — make it curiosity-driven, NOT salesy. They must feel they need to open it\\n2. Open with something hyper-specific to THEIR business — use their name, niche, city, or something from their website snippet\\n3. Identify ONE clear pain point they feel daily — missed calls = missed revenue\\n4. Present the solution briefly — don't over-explain, leave room for curiosity\\n5. ONE soft, low-friction CTA — a quick reply or a 10-minute call\\n6. Max 150 words for the body — shorter is always better\\n7. Conversational, human tone — NOT corporate, NOT robotic\\n8. Sign off as Ayo\\n\\nReturn ONLY a valid JSON object with these exact keys, nothing else:\\n{\\\"subject\\\": \\\"...\\\", \\\"body\\\": \\\"...\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a cold email for this business:\\n\\nBusiness Name: {{ $json.business_name }}\\nNiche: {{ $json.niche_name }}\\nCity: {{ $json.city }}\\nCountry: {{ $json.country_name }}\\nWebsite: {{ $json.website }}\\nPhone: {{ $json.phone }}\\nWebsite Snippet: {{ $json.snippet }}\\n\\nUse these details to make it feel like Ayo personally researched this business. Reference something specific about them — their city, their niche, or something from the snippet. The goal is ONE reply.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "claude-write-email",
      "name": "Claude - Write Personalized Email",
      "type": "n8n-nodes-base.httpRequest",
