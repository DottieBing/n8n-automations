    {
      "parameters": {
        "method": "GET",
        "url": "https://app.scrapingbee.com/api/v1/",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{ $json.scrapingbee_key }}"
            },
            {
              "name": "url",
              "value": "={{ 'https://www.' + $json.google_domain + '/search?q=' + encodeURIComponent($json.search_query) + '&num=5' }}"
            },
            {
              "name": "render_js",
              "value": "false"
            },
            {
              "name": "extract_rules",
              "value": "={{ JSON.stringify({ \"results\": { \"selector\": \"div.g\", \"type\": \"list\", \"output\": { \"title\": { \"selector\": \"h3\" }, \"url\": { \"selector\": \"a\", \"output\": \"@href\" }, \"snippet\": { \"selector\": \"div.VwiC3b\" } } } }) }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "scrapingbee-google-dork",
      "name": "ScrapingBee - Google Dork Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
