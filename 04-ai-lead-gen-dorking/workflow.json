              "value": "={{ JSON.stringify({ \"emails\": { \"selector\": \"a[href^='mailto:']\", \"type\": \"list\", \"output\": \"@href\" }, \"business_name\": { \"selector\": \"title\" }, \"phone\": { \"selector\": \"a[href^='tel:']\", \"output\": \"@href\" } }) }}"
