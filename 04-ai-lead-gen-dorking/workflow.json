      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "results",
              "name": "results",
              "value": "={{ (() => { try { if (Array.isArray($json.results)) { return $json.results.filter(r => r.url && r.url.startsWith('http') && !r.url.includes('google') && !r.url.includes('yelp') && !r.url.includes('yellowpages') && !r.url.includes('tripadvisor') && !r.url.includes('healthgrades') && !r.url.includes('facebook') && !r.url.includes('instagram') && !r.url.includes('linkedin')); } return []; } catch(e) { return []; } })() }}",
              "type": "array"
            },
            {
              "id": "niche_name",
              "name": "niche_name",
              "value": "={{ $('build-dork-query').item.json.niche_name }}",
              "type": "string"
            },
            {
              "id": "niche_sheet",
              "name": "niche_sheet",
              "value": "={{ $('build-dork-query').item.json.niche_sheet }}",
              "type": "string"
