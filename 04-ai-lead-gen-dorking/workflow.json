              "id": "business_name",
              "name": "business_name",
              "value": "={{ (() => { const name = $json.business_name || $('split-results').item.json.results.title || ''; return name.replace(/[-|].*$/, '').trim(); })() }}",
              "type": "string"
            },
            {
              "id": "website",
              "name": "website",
              "value": "={{ $('split-results').item.json.results.url }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ (() => { try { const emails = $json.emails; if (Array.isArray(emails) && emails.length > 0) { return emails[0].replace('mailto:', '').trim().toLowerCase(); } return ''; } catch(e) { return ''; } })() }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ (() => { try { const phone = $json.phone; if (phone) return phone.replace('tel:', '').trim(); return ''; } catch(e) { return ''; } })() }}",
