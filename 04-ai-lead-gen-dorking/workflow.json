              "value": "={{ $('build-dork-query').item.json.scrapingbee_key }}",
              "type": "string"
            },
            {
              "id": "anthropic_key",
              "name": "anthropic_key",
              "value": "={{ $('build-dork-query').item.json.anthropic_key }}",
              "type": "string"
            },
