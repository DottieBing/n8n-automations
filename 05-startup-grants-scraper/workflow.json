        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"query\": \"{ posts(first: 20, order: NEWEST) { edges { node { id name tagline url createdAt topics { edges { node { name } } } } } } }\"\n}",
        "options": {}
