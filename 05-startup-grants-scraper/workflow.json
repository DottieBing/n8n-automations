      "id": "producthunt-search",
      "name": "Product Hunt Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst redditRaw = items[0].json;\nconst results = [];\n\nconst keywords = ['startup grant', 'pitch', 'accelerator', 'ideathon', 'hackathon'];\n\nfunction containsKeyword(text) {\n  if (!text) return false;\n  const lower = text.toLowerCase();\n  return keywords.some(kw => lower.includes(kw));\n}\n\nfunction extractDate(text) {\n  if (!text) return 'Not found';\n  const patterns = [\n    /deadline[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /closes?[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /due[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /apply by[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /ends?[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /(\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4})/,\n    /([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/\n  ];\n  for (const pattern of patterns) {\n    const match = text.match(pattern);\n    if (match) return match[1] || match[0];\n  }\n  return 'Not found';\n}\n\nfunction extractLink(text) {\n  if (!text) return 'Not found';\n  const urlPattern = /https?:\\/\\/[^\\s\\)\\]]+/g;\n  const urls = text.match(urlPattern);\n  if (urls) {\n    const filtered = urls.filter(u => !u.includes('reddit.com') && !u.includes('redd.it'));\n    return filtered.length > 0 ? filtered[0] : (urls[0] || 'Not found');\n  }\n  return 'Not found';\n}\n\n// Process Reddit\ntry {\n  const posts = redditRaw?.data?.children || [];\n  for (const post of posts) {\n    const d = post.data;\n    const combined = `${d.title || ''} ${d.selftext || ''}`;\n    if (containsKeyword(combined)) {\n      results.push({\n        date_found: new Date().toISOString(),\n        platform: 'Reddit',\n        post_url: `https://reddit.com${d.permalink}`,\n        grant_link: extractLink(d.selftext || d.url || ''),\n        title: d.title || '',\n        start_date: 'Not found',\n        deadline: extractDate(combined),\n        author: d.author || '',\n        summary: (d.selftext || d.title || '').substring(0, 300)\n      });\n    }\n  }\n} catch(e) {}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "parse-reddit",
      "name": "Parse Reddit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst hnRaw = items[0].json;\nconst results = [];\n\nconst keywords = ['startup grant', 'pitch', 'accelerator', 'ideathon', 'hackathon'];\n\nfunction containsKeyword(text) {\n  if (!text) return false;\n  const lower = text.toLowerCase();\n  return keywords.some(kw => lower.includes(kw));\n}\n\nfunction extractDate(text) {\n  if (!text) return 'Not found';\n  const patterns = [\n    /deadline[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /closes?[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /due[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /apply by[:\\s]+([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n    /(\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4})/,\n    /([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/\n  ];\n  for (const pattern of patterns) {\n    const match = text.match(pattern);\n    if (match) return match[1] || match[0];\n  }\n  return 'Not found';\n}\n\ntry {\n  const hits = hnRaw?.hits || [];\n  for (const hit of hits) {\n    const combined = `${hit.title || ''} ${hit.story_text || ''}`;\n    if (containsKeyword(combined)) {\n      results.push({\n        date_found: new Date().toISOString(),\n        platform: 'HackerNews',\n        post_url: hit.url || `https://news.ycombinator.com/item?id=${hit.objectID}`,\n        grant_link: hit.url || 'Not found',\n        title: hit.title || '',\n        start_date: 'Not found',\n        deadline: extractDate(combined),\n        author: hit.author || '',\n        summary: (hit.story_text || hit.title || '').substring(0, 300)\n      });\n    }\n  }\n} catch(e) {}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "parse-hackernews",
      "name": "Parse HackerNews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst phRaw = items[0].json;\nconst results = [];\n\nconst keywords = ['startup grant', 'pitch', 'accelerator', 'ideathon', 'hackathon'];\n\nfunction containsKeyword(text) {\n  if (!text) return false;\n  const lower = text.toLowerCase();\n  return keywords.some(kw => lower.includes(kw));\n}\n\ntry {\n  const posts = phRaw?.data?.posts?.edges || [];\n  for (const edge of posts) {\n    const p = edge.node;\n    const combined = `${p.name || ''} ${p.tagline || ''}`;\n    const topics = (p.topics?.edges || []).map(t => t.node.name).join(', ');\n    if (containsKeyword(combined) || containsKeyword(topics)) {\n      results.push({\n        date_found: new Date().toISOString(),\n        platform: 'Product Hunt',\n        post_url: p.url || '',\n        grant_link: p.url || 'Not found',\n        title: p.name || '',\n        start_date: 'Not found',\n        deadline: 'Not found',\n        author: '',\n        summary: p.tagline || ''\n      });\n    }\n  }\n} catch(e) {}\n\nreturn results.map(r => ({ json: r }));"
      },
