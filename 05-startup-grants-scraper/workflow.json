    {
      "parameters": {
        "jsCode": "// Get all new results\nconst allItems = $('Merge All Results').all();\n\n// Get existing rows from sheet to deduplicate\nconst existingRows = $('Get Existing Sheet Rows').all();\nconst existingUrls = new Set(\n  existingRows.map(r => r.json.post_url || r.json['Post URL'] || '').filter(Boolean)\n);\n\n// Filter out duplicates\nconst newItems = allItems.filter(item => {\n  const url = item.json.post_url;\n  if (!url || existingUrls.has(url)) return false;\n  return true;\n});\n\nif (newItems.length === 0) {\n  return [{ json: { skipped: true, message: 'No new items found' } }];\n}\n\nreturn newItems;"
      },
